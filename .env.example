# Cloud Mail 3.0.0 账号密码接口，地址不包含 /api。
CLOUD_MAIL_URL=https://mail.example.org
CLOUD_MAIL_EMAIL=
# 含 # 等字符时使用引号。
CLOUD_MAIL_PASSWORD=
# Docker 镜像，固定版本时可改为 ghcr.io/dnslin/nodes:0.2.1。
NODES_IMAGE=ghcr.io/dnslin/nodes:latest
# 自动查找 Chrome/Chromium；Docker 默认 /usr/bin/chromium。
BROWSER_PATH=
# 留空使用安装包内的 nodes/resources/turnstile/。
TURNSTILE_EXTENSION_PATH=
