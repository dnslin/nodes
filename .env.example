# Cloud Mail 3.0.0 账号密码接口，地址不包含 /api。
CLOUD_MAIL_URL=https://mail.example.org
CLOUD_MAIL_EMAIL=
# 含 # 等字符时使用引号。
CLOUD_MAIL_PASSWORD=
# Docker 镜像，固定版本时可改为 ghcr.io/dnslin/nodes:0.4.0。
NODES_IMAGE=ghcr.io/dnslin/nodes:latest
# 自动查找 Chrome/Chromium；Docker 默认 /usr/bin/chromium。
BROWSER_PATH=
# 留空使用安装包内的 nodes/resources/turnstile/。
TURNSTILE_EXTENSION_PATH=
# 可选：同时填写 Resin 站点地址和管理令牌，导出后自动合并到一个专用本地订阅。
# 地址不包含 /api/v1；使用管理令牌，不是代理令牌。留空则不连接 Resin。
RESIN_URL=
RESIN_ADMIN_TOKEN=
RESIN_SUBSCRIPTION_NAME=nodes
